{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "music-media",
  "description": "Only YouTube Music may update native media metadata. No window, shell or plugin access.",
  "windows": [
    "main"
  ],
  "local": false,
  "remote": {
    "urls": [
      "https://music.youtube.com/*"
    ]
  },
  "permissions": [
    "allow-update-track-info",
    "allow-update-playback-state"
  ]
}
